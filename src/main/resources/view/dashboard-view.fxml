<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.awenocorp.abarroteria.kinal.controller.DashboardController">
    <stylesheets>
        <URL value="@/main/resources/css/dashboard-view.css" />
    </stylesheets>
   <children>
      <GridPane prefHeight="400.0" prefWidth="600.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="199.0" minWidth="0.0" prefWidth="0.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="581.0" minWidth="10.0" prefWidth="581.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="157.0" minWidth="0.0" prefWidth="0.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints maxHeight="312.0" minHeight="10.0" prefHeight="19.0" vgrow="SOMETIMES" />
          <RowConstraints maxHeight="343.0" minHeight="10.0" prefHeight="306.0" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="312.0" minHeight="10.0" prefHeight="53.0" vgrow="SOMETIMES" />
          <RowConstraints maxHeight="129.0" minHeight="0.0" prefHeight="46.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <StackPane prefHeight="150.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <TableView fx:id="tableProducto" prefHeight="288.0" prefWidth="581.0">
                    <columns>
                      <TableColumn fx:id="tableColumnIdProducto" prefWidth="75.0" text="id" />
                      <TableColumn fx:id="tableColumnNombreProducto" prefWidth="148.0" text="nombre" />
                      <TableColumn fx:id="tableColumnStock" prefWidth="170.0" text="stock" />
                      <TableColumn fx:id="tableColumnPrecio" prefWidth="187.0" text="precio" />
                    </columns>
                  </TableView>
               </children>
            </StackPane>
            <Button fx:id="buttonEliminar" mnemonicParsing="false" onAction="#eliminarProducto" styleClass="btn-eliminar" text="Eliminar" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
         </children>
      </GridPane>
   </children>
</AnchorPane>