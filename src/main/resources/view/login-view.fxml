<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    prefHeight="419.0"
    prefWidth="668.0"
    styleClass="back"
    stylesheets="@../css/styles.css"
    xmlns="http://javafx.com/javafx/21.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="main.java.com.awenocorp.abarroteria.kinal.controller.LoginController">

    <children>

        <!-- ========================================= -->
        <!-- CONTENEDOR PRINCIPAL -->
        <!-- ========================================= -->

        <StackPane
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">

            <children>

                <!-- ========================================= -->
                <!-- TARJETA PRINCIPAL DEL LOGIN -->
                <!-- ========================================= -->

                <VBox
                    alignment="TOP_CENTER"
                    maxWidth="570.0"
                    prefWidth="570.0"
                    spacing="0.0"
                    style="
                        -fx-background-color: #F9F9FC;
                        -fx-background-radius: 22;
                        -fx-effect: dropshadow(
                            gaussian,
                            rgba(0,0,0,0.40),
                            25,
                            0.25,
                            0,
                            8
                        );
                    "
                    StackPane.alignment="CENTER">

                    <padding>
                        <Insets
                            top="22.0"
                            right="45.0"
                            bottom="25.0"
                            left="45.0"/>
                    </padding>

                    <children>

                        <!-- ================================= -->
                        <!-- LOGO -->
                        <!-- ================================= -->

                        <ImageView
                            fitHeight="135.0"
                            fitWidth="285.0"
                            pickOnBounds="true"
                            preserveRatio="true">

                            <image>
                                <Image
                                    url="@../images/ChatGPT%20Image%2010%20jul%202026,%2016_52_28.png"/>
                            </image>

                        </ImageView>


                        <!-- ================================= -->
                        <!-- TÍTULO DE BIENVENIDA -->
                        <!-- ================================= -->

                        <Label
                            text="Bienvenido a Abarrotería Kinal"
                            alignment="CENTER"
                            maxWidth="Infinity"
                            style="
                                -fx-font-size: 24px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #171A63;
                            "/>


                        <!-- ================================= -->
                        <!-- DESCRIPCIÓN -->
                        <!-- ================================= -->

                        <Label
                            text="Ingresa tus datos para continuar"
                            alignment="CENTER"
                            maxWidth="Infinity"
                            style="
                                -fx-font-size: 15px;
                                -fx-text-fill: #62658A;
                            ">

                            <VBox.margin>
                                <Insets bottom="18.0"/>
                            </VBox.margin>

                        </Label>


                        <!-- ================================= -->
                        <!-- LABEL USUARIO -->
                        <!-- ================================= -->

                        <Label
                            text="Usuario o correo"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity"
                            style="
                                -fx-font-size: 15px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #171A63;
                            "/>


                        <!-- ================================= -->
                        <!-- CAMPO USUARIO -->
                        <!-- ================================= -->

                        <TextField
                            fx:id="txtFieldEmail"
                            promptText="Ingresa tu usuario o correo"
                            prefHeight="42.0"
                            maxWidth="Infinity"
                            style="
                                -fx-background-color: white;
                                -fx-border-color: #D4D6E5;
                                -fx-border-width: 1;
                                -fx-border-radius: 8;
                                -fx-background-radius: 8;
                                -fx-font-size: 14px;
                                -fx-padding: 0 12 0 12;
                            ">

                            <VBox.margin>
                                <Insets bottom="14.0"/>
                            </VBox.margin>

                        </TextField>


                        <!-- ================================= -->
                        <!-- LABEL CONTRASEÑA -->
                        <!-- ================================= -->

                        <Label
                            text="Contraseña"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity"
                            style="
                                -fx-font-size: 15px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #171A63;
                            "/>


                        <!-- ================================= -->
                        <!-- CAMPO CONTRASEÑA -->
                        <!-- ================================= -->

                        <PasswordField
                            fx:id="txtFieldPassword"
                            promptText="Ingresa tu contraseña"
                            prefHeight="42.0"
                            maxWidth="Infinity"
                            style="
                                -fx-background-color: white;
                                -fx-border-color: #D4D6E5;
                                -fx-border-width: 1;
                                -fx-border-radius: 8;
                                -fx-background-radius: 8;
                                -fx-font-size: 14px;
                                -fx-padding: 0 12 0 12;
                            "/>


                        <!-- ================================= -->
                        <!-- OLVIDASTE CONTRASEÑA -->
                        <!-- ================================= -->

                        <HBox
                            alignment="CENTER_RIGHT"
                            maxWidth="Infinity">

                            <VBox.margin>
                                <Insets
                                    top="4.0"
                                    bottom="14.0"/>
                            </VBox.margin>

                            <children>

                                <Hyperlink
                                    text="¿Olvidaste tu contraseña?"
                                    style="
                                        -fx-text-fill: #1769E0;
                                        -fx-font-size: 13px;
                                        -fx-border-color: transparent;
                                    "/>

                            </children>

                        </HBox>


                        <!-- ================================= -->
                        <!-- BOTONES -->
                        <!-- ================================= -->

                        <HBox
                            alignment="CENTER"
                            spacing="18.0"
                            maxWidth="Infinity">

                            <children>

                                <!-- BOTÓN INICIAR SESIÓN -->

                                <Button
                                    fx:id="btnIniciarSesion"
                                    mnemonicParsing="false"
                                    onAction="#handleLogin"
                                    text="Iniciar Sesión"
                                    prefHeight="43.0"
                                    prefWidth="215.0"
                                    style="
                                        -fx-background-color: #20B84B;
                                        -fx-background-radius: 8;
                                        -fx-text-fill: white;
                                        -fx-font-size: 15px;
                                        -fx-font-weight: bold;
                                        -fx-cursor: hand;
                                    "/>


                                <!-- BOTÓN REGISTRARSE -->

                                <Button
                                    mnemonicParsing="false"
                                    text="Registrarse"
                                    prefHeight="43.0"
                                    prefWidth="215.0"
                                    style="
                                        -fx-background-color: #10B9E8;
                                        -fx-background-radius: 8;
                                        -fx-text-fill: white;
                                        -fx-font-size: 15px;
                                        -fx-font-weight: bold;
                                        -fx-cursor: hand;
                                    "/>

                            </children>

                        </HBox>


                        <!-- ================================= -->
                        <!-- SEPARADOR -->
                        <!-- ================================= -->

                        <HBox
                            alignment="CENTER"
                            spacing="10.0"
                            maxWidth="Infinity">

                            <VBox.margin>
                                <Insets top="20.0"/>
                            </VBox.margin>

                            <children>

                                <Label
                                    text="────────"
                                    style="
                                        -fx-text-fill: #D8D9E5;
                                        -fx-font-size: 12px;
                                    "/>


                                <Label
                                    text="¿No tienes una cuenta?"
                                    style="
                                        -fx-text-fill: #62658A;
                                        -fx-font-size: 13px;
                                    "/>


                                <Label
                                    text="────────"
                                    style="
                                        -fx-text-fill: #D8D9E5;
                                        -fx-font-size: 12px;
                                    "/>

                            </children>

                        </HBox>

                    </children>

                </VBox>


                <!-- ========================================= -->
                <!-- FOOTER -->
                <!-- ========================================= -->

                <Label
                    text="© 2026 Abarrotería Kinal  |  Sistema de Ventas"
                    style="
                        -fx-text-fill: white;
                        -fx-font-size: 13px;
                    "
                    StackPane.alignment="BOTTOM_CENTER">

                    <StackPane.margin>
                        <Insets bottom="12.0"/>
                    </StackPane.margin>

                </Label>

            </children>

        </StackPane>

    </children>

</AnchorPane>